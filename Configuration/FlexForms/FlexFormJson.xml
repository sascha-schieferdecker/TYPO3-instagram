<?xml version="1.0"?>
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <main>
            <ROOT>
                <sheetTitle>Instagram</sheetTitle>
                <type>array</type>
                <el>
                    <settings.usernames>
                        <label>Show posts from these Instagram accounts (one per line):</label>
                        <config>
                            <type>text</type>
                            <cols>30</cols>
                            <rows>5</rows>
                            <eval>trim,required</eval>
                        </config>
                    </settings.usernames>
                    <settings.domainprefix>
                        <exclude>1</exclude>
                        <label>Prefix media URLs with this domain:</label>
                        <config>
                            <type>input</type>
                            <placeholder>https://xxx.yyy</placeholder>
                            <eval>trim,required</eval>
                        </config>
                    </settings.domainprefix>
                    <settings.limit>
                        <exclude>1</exclude>
                        <label>Limit</label>
                        <config>
                            <type>input</type>
                            <default>10</default>
                            <eval>trim,int,required</eval>
                            <range>
                                <lower>1</lower>
                                <upper>100</upper>
                            </range>
                            <slider>
                                <step>1</step>
                                <width>400</width>
                            </slider>
                        </config>
                    </settings.limit>
                </el>
            </ROOT>
        </main>
    </sheets>
</T3DataStructure>
